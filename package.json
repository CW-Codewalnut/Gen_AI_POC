    "ai": "^7.0.138",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "hono": "^4.13.13",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
